
.home-page.data-v-57280228 {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: 30rpx;
}

/* 轮播图样式 */
.banner-section.data-v-57280228 {
  padding: 30rpx;
}
.banner-swiper.data-v-57280228 {
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.15);
}
.banner-item.data-v-57280228 {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-click-area.data-v-57280228 {
  width: 100%;
  height: 100%;
  position: relative;
}
.banner-image.data-v-57280228 {
  width: 100%;
  height: 100%;
}
.banner-info.data-v-57280228 {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  color: #FFFFFF;
}
.banner-title.data-v-57280228 {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.banner-desc.data-v-57280228 {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 快捷入口样式 */
.quick-entry.data-v-57280228 {
  margin: 0 30rpx 30rpx;
}
.card.data-v-57280228 {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.grid.data-v-57280228 {
  padding: 20rpx 0;
}
.grid-item.data-v-57280228 {
  width: 25%;
  padding: 20rpx 10rpx;
  box-sizing: border-box;
  text-align: center;
  position: relative;
  z-index: 10;
}
.grid-item-icon.data-v-57280228 {
  width: 96rpx;
  height: 96rpx;
  background-color: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  position: relative;
  z-index: 10;
}
.icon-text.data-v-57280228 {
  font-size: 44rpx;
}
.grid-item-text.data-v-57280228 {
  font-size: 24rpx;
  color: #333333;
}

