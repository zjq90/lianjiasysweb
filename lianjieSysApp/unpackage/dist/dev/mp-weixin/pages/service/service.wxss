
.service-page.data-v-4c0f6f1c {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding: 30rpx;
}

/* 卡片样式 */
.card.data-v-4c0f6f1c {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.card-header.data-v-4c0f6f1c {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #E0E0E0;
}
.header-title.data-v-4c0f6f1c {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.header-more.data-v-4c0f6f1c {
  font-size: 24rpx;
  color: #4CAF50;
}
.card-body.data-v-4c0f6f1c {
  padding: 24rpx 30rpx;
}

/* 标签样式 */
.tag-section.data-v-4c0f6f1c {
  margin-bottom: 24rpx;
}
.tag-label.data-v-4c0f6f1c {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}
.tag-list.data-v-4c0f6f1c {
  display: flex;
  flex-wrap: wrap;
}
.tag-item.data-v-4c0f6f1c {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #F5F5F5;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
}
.tag-item.active.data-v-4c0f6f1c {
  background-color: #E8F5E9;
}
.tag-icon.data-v-4c0f6f1c {
  font-size: 28rpx;
  margin-right: 8rpx;
}
.tag-name.data-v-4c0f6f1c {
  font-size: 24rpx;
  color: #666666;
}
.tag-item.active .tag-name.data-v-4c0f6f1c {
  color: #4CAF50;
}

/* 推荐按钮 */
.recommend-btn.data-v-4c0f6f1c {
  padding: 10rpx 0;
}
.btn.data-v-4c0f6f1c {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.btn-primary.data-v-4c0f6f1c {
  background-color: #4CAF50;
  color: #FFFFFF;
}
.btn-block.data-v-4c0f6f1c {
  width: 100%;
}

/* 模块区域 */
.module-section.data-v-4c0f6f1c {
  margin-top: 10rpx;
}
.section-header.data-v-4c0f6f1c {
  margin-bottom: 20rpx;
}
.section-title.data-v-4c0f6f1c {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

/* 模块项 */
.module-item.data-v-4c0f6f1c {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.module-icon.data-v-4c0f6f1c {
  width: 96rpx;
  height: 96rpx;
  background-color: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.icon-text.data-v-4c0f6f1c {
  font-size: 44rpx;
}
.module-content.data-v-4c0f6f1c {
  flex: 1;
}
.module-title.data-v-4c0f6f1c {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}
.module-desc.data-v-4c0f6f1c {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}
.module-arrow.data-v-4c0f6f1c {
  padding-left: 20rpx;
}
.arrow-icon.data-v-4c0f6f1c {
  font-size: 40rpx;
  color: #CCCCCC;
}

