<view class="package-list-page data-v-4896a47e"><view class="search-section card data-v-4896a47e"><view class="search-box data-v-4896a47e"><input class="search-input data-v-4896a47e" placeholder="搜索套餐..." data-event-opts="{{[['confirm',[['searchPackage',['$event']]]],['input',[['__set_model',['','searchKeyword','$event',[]]]]]]}}" value="{{searchKeyword}}" bindconfirm="__e" bindinput="__e"/><view data-event-opts="{{[['tap',[['searchPackage',['$event']]]]]}}" class="search-btn data-v-4896a47e" bindtap="__e"><text class="search-icon data-v-4896a47e">🔍</text></view></view><view class="filter-section data-v-4896a47e"><view data-event-opts="{{[['tap',[['filterPackage',['all']]]]]}}" class="{{['filter-item','data-v-4896a47e',(currentFilter==='all')?'active':'']}}" bindtap="__e"><text class="filter-text data-v-4896a47e">全部</text></view><block wx:for="{{filterTags}}" wx:for-item="tag" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['filterPackage',['$0'],[[['filterTags','id',tag.id,'name']]]]]]]}}" class="{{['filter-item','data-v-4896a47e',(currentFilter===tag.name)?'active':'']}}" bindtap="__e"><text class="filter-text data-v-4896a47e">{{tag.name}}</text></view></block></view></view><view class="package-list data-v-4896a47e"><block wx:for="{{filteredPackages}}" wx:for-item="item" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['viewPackageDetail',['$0'],[[['filteredPackages','id',item.id]]]]]]]}}" class="package-item card data-v-4896a47e" bindtap="__e"><image class="package-image data-v-4896a47e" src="{{item.image}}" mode="aspectFill"></image><view class="package-info data-v-4896a47e"><view class="package-header data-v-4896a47e"><text class="package-name data-v-4896a47e">{{item.name}}</text><view class="package-tags data-v-4896a47e"><block wx:for="{{item.tags}}" wx:for-item="tag" wx:for-index="__i2__" wx:key="*this"><text class="tag tag-primary data-v-4896a47e">{{tag}}</text></block></view></view><view class="package-desc data-v-4896a47e"><text class="desc-text data-v-4896a47e">{{item.description}}</text></view><view class="package-specs data-v-4896a47e"><view class="spec-item data-v-4896a47e"><text class="spec-label data-v-4896a47e">时长：</text><text class="spec-value data-v-4896a47e">{{item.duration}}</text></view><view class="spec-item data-v-4896a47e"><text class="spec-label data-v-4896a47e">面积：</text><text class="spec-value data-v-4896a47e">{{item.area}}</text></view><view class="spec-item data-v-4896a47e"><text class="spec-label data-v-4896a47e">已售：</text><text class="spec-value data-v-4896a47e">{{item.sales+"份"}}</text></view></view><view class="package-footer data-v-4896a47e"><view class="price-section data-v-4896a47e"><text class="price-label data-v-4896a47e">¥</text><text class="price-value data-v-4896a47e">{{item.price}}</text><text class="price-original data-v-4896a47e">{{"原价¥"+item.originalPrice}}</text></view><view class="action-btn data-v-4896a47e"><button data-event-opts="{{[['tap',[['purchasePackage',['$0'],[[['filteredPackages','id',item.id]]]]]]]}}" class="btn btn-primary btn-small data-v-4896a47e" catchtap="__e">立即选购</button></view></view></view></view></block></view><block wx:if="{{filteredPackages.length===0}}"><view class="empty data-v-4896a47e"><text class="empty-icon data-v-4896a47e">📋</text><text class="empty-text data-v-4896a47e">暂无相关套餐</text></view></block></view>