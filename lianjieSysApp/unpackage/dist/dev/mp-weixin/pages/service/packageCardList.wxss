
.package-card-page.data-v-7118811e {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding: 30rpx;
}

/* 顶部操作栏 */
.card.data-v-7118811e {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.action-bar.data-v-7118811e {
  display: flex;
  flex-direction: column;
  padding: 24rpx 30rpx;
}
.tab-section.data-v-7118811e {
  display: flex;
  margin-bottom: 20rpx;
}
.tab-item.data-v-7118811e {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 20rpx;
  background-color: #F5F5F5;
  border-radius: 30rpx;
  position: relative;
  transition: all 0.3s ease;
}
.tab-item.active.data-v-7118811e {
  background-color: #E8F5E9;
}
.tab-text.data-v-7118811e {
  font-size: 26rpx;
  color: #666666;
}
.tab-item.active .tab-text.data-v-7118811e {
  color: #4CAF50;
  font-weight: 500;
}
.tab-badge.data-v-7118811e {
  font-size: 20rpx;
  color: #FFFFFF;
  background-color: #F44336;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
}
.add-btn.data-v-7118811e {
  align-self: flex-end;
}
.btn.data-v-7118811e {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
}
.btn-primary.data-v-7118811e {
  background-color: #4CAF50;
  color: #FFFFFF;
}
.btn-small.data-v-7118811e {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}
.btn-icon.data-v-7118811e {
  font-size: 28rpx;
  margin-right: 6rpx;
}

/* 套餐卡列表 */
.card-list.data-v-7118811e {
  display: flex;
  flex-direction: column;
}
.card-item.data-v-7118811e {
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
  position: relative;
  overflow: hidden;
}
.card-item.data-v-7118811e::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}
.card-item.expired.data-v-7118811e {
  background: linear-gradient(135deg, #9E9E9E 0%, #BDBDBD 100%);
}
.card-header.data-v-7118811e {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}
.card-title.data-v-7118811e {
  display: flex;
  align-items: center;
}
.card-name.data-v-7118811e {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.card-status.data-v-7118811e {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}
.status-valid.data-v-7118811e {
  background-color: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}
.status-expired.data-v-7118811e {
  background-color: rgba(0, 0, 0, 0.2);
  color: #FFFFFF;
}
.card-no.data-v-7118811e {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}
.card-body.data-v-7118811e {
  position: relative;
  z-index: 1;
}
.card-info.data-v-7118811e {
  display: flex;
  margin-bottom: 12rpx;
}
.info-label.data-v-7118811e {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
.info-value.data-v-7118811e {
  font-size: 24rpx;
  color: #FFFFFF;
}
.card-count.data-v-7118811e {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
}
.count-item.data-v-7118811e {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.count-value.data-v-7118811e {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.count-value.total.data-v-7118811e {
  color: rgba(255, 255, 255, 0.7);
}
.count-label.data-v-7118811e {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}
.count-divider.data-v-7118811e {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.5);
  margin: 0 40rpx;
}
.card-footer.data-v-7118811e {
  position: relative;
  z-index: 1;
}
.progress-bar.data-v-7118811e {
  height: 12rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.progress-fill.data-v-7118811e {
  height: 100%;
  background-color: #FFFFFF;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.progress-info.data-v-7118811e {
  display: flex;
  justify-content: flex-end;
}
.progress-text.data-v-7118811e {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 操作按钮 */
.card-actions.data-v-7118811e {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}
.action-btn.data-v-7118811e {
  padding: 8rpx 20rpx;
  margin-left: 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}
.action-text.data-v-7118811e {
  font-size: 24rpx;
  color: #FFFFFF;
}
.action-text.use.data-v-7118811e {
  color: #FFD700;
  font-weight: 500;
}
.action-text.delete.data-v-7118811e {
  color: #FF6B6B;
}

/* 空状态 */
.empty.data-v-7118811e {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.empty-icon.data-v-7118811e {
  font-size: 120rpx;
  color: #999999;
  margin-bottom: 24rpx;
}
.empty-text.data-v-7118811e {
  font-size: 28rpx;
  color: #999999;
}

