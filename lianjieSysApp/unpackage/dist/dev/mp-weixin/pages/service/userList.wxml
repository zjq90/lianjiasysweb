<view class="user-list-page data-v-74aa3c1c"><view class="search-section card data-v-74aa3c1c"><view class="search-box data-v-74aa3c1c"><input class="search-input data-v-74aa3c1c" placeholder="搜索用户名或手机号..." data-event-opts="{{[['confirm',[['searchUser',['$event']]]],['input',[['__set_model',['','searchKeyword','$event',[]]]]]]}}" value="{{searchKeyword}}" bindconfirm="__e" bindinput="__e"/><view data-event-opts="{{[['tap',[['searchUser',['$event']]]]]}}" class="search-btn data-v-74aa3c1c" bindtap="__e"><text class="search-icon data-v-74aa3c1c">🔍</text></view></view><view class="filter-section data-v-74aa3c1c"><view data-event-opts="{{[['tap',[['filterUser',['all']]]]]}}" class="{{['filter-item','data-v-74aa3c1c',(currentFilter==='all')?'active':'']}}" bindtap="__e"><text class="filter-text data-v-74aa3c1c">全部</text></view><view data-event-opts="{{[['tap',[['filterUser',['active']]]]]}}" class="{{['filter-item','data-v-74aa3c1c',(currentFilter==='active')?'active':'']}}" bindtap="__e"><text class="filter-text data-v-74aa3c1c">正常</text></view><view data-event-opts="{{[['tap',[['filterUser',['inactive']]]]]}}" class="{{['filter-item','data-v-74aa3c1c',(currentFilter==='inactive')?'active':'']}}" bindtap="__e"><text class="filter-text data-v-74aa3c1c">禁用</text></view></view></view><view class="stats-section data-v-74aa3c1c"><view class="stat-item card data-v-74aa3c1c"><text class="stat-value data-v-74aa3c1c">{{userList.length}}</text><text class="stat-label data-v-74aa3c1c">总用户数</text></view><view class="stat-item card data-v-74aa3c1c"><text class="stat-value data-v-74aa3c1c">{{activeCount}}</text><text class="stat-label data-v-74aa3c1c">正常用户</text></view><view class="stat-item card data-v-74aa3c1c"><text class="stat-value data-v-74aa3c1c">{{inactiveCount}}</text><text class="stat-label data-v-74aa3c1c">禁用用户</text></view></view><view class="user-list data-v-74aa3c1c"><block wx:for="{{filteredUsers}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="user-item card data-v-74aa3c1c"><view class="user-header data-v-74aa3c1c"><view data-event-opts="{{[['tap',[['viewUserDetail',['$0'],[[['filteredUsers','id',item.id]]]]]]]}}" class="user-info data-v-74aa3c1c" bindtap="__e"><image class="user-avatar data-v-74aa3c1c" src="{{item.avatar}}" mode="aspectFill"></image><view class="user-base data-v-74aa3c1c"><view class="user-name-row data-v-74aa3c1c"><text class="user-name data-v-74aa3c1c">{{item.name}}</text><view class="{{['status-tag','data-v-74aa3c1c',item.status===1?'status-active':'status-inactive']}}"><text class="status-text data-v-74aa3c1c">{{item.status===1?'正常':'禁用'}}</text></view></view><text class="user-phone data-v-74aa3c1c">{{item.phone}}</text><text class="user-openid data-v-74aa3c1c">{{"OpenID: "+item.openId}}</text></view></view><view class="user-actions data-v-74aa3c1c"><view data-event-opts="{{[['tap',[['editUser',['$0'],[[['filteredUsers','id',item.id]]]]]]]}}" class="action-btn data-v-74aa3c1c" bindtap="__e"><text class="action-text data-v-74aa3c1c">编辑</text></view><view data-event-opts="{{[['tap',[['toggleStatus',['$0'],[[['filteredUsers','id',item.id]]]]]]]}}" class="action-btn data-v-74aa3c1c" bindtap="__e"><text class="{{['action-text','data-v-74aa3c1c',item.status===1?'text-danger':'text-success']}}">{{''+(item.status===1?'禁用':'启用')+''}}</text></view><view data-event-opts="{{[['tap',[['deleteUser',['$0'],[[['filteredUsers','id',item.id]]]]]]]}}" class="action-btn data-v-74aa3c1c" bindtap="__e"><text class="action-text delete data-v-74aa3c1c">删除</text></view></view></view><view class="user-footer data-v-74aa3c1c"><view class="footer-info data-v-74aa3c1c"><text class="footer-label data-v-74aa3c1c">创建时间：</text><text class="footer-value data-v-74aa3c1c">{{item.createTime}}</text></view><view class="footer-actions data-v-74aa3c1c"><text data-event-opts="{{[['tap',[['viewUserDetail',['$0'],[[['filteredUsers','id',item.id]]]]]]]}}" class="footer-action data-v-74aa3c1c" bindtap="__e">查看详情</text></view></view></view></block></view><block wx:if="{{filteredUsers.length===0}}"><view class="empty data-v-74aa3c1c"><text class="empty-icon data-v-74aa3c1c">👥</text><text class="empty-text data-v-74aa3c1c">暂无用户</text></view></block><view class="fixed-bottom safe-area-bottom data-v-74aa3c1c"><button data-event-opts="{{[['tap',[['addUser',['$event']]]]]}}" class="btn btn-primary btn-block data-v-74aa3c1c" bindtap="__e"><text class="btn-icon data-v-74aa3c1c">+</text><text class="btn-text data-v-74aa3c1c">新增用户</text></button></view></view>