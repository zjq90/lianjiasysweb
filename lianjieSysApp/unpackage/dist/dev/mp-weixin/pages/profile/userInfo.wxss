
.user-info-page.data-v-8b95dc90 {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 卡片样式 */
.card.data-v-8b95dc90 {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 头像区域 */
.avatar-section.data-v-8b95dc90 {
  padding: 24rpx 30rpx;
}
.avatar-item.data-v-8b95dc90 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.label.data-v-8b95dc90 {
  font-size: 28rpx;
  color: #333333;
}
.avatar-content.data-v-8b95dc90 {
  display: flex;
  align-items: center;
}
.user-avatar.data-v-8b95dc90 {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}
.arrow.data-v-8b95dc90 {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
}

/* 信息项 */
.info-item.data-v-8b95dc90 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.info-item.data-v-8b95dc90:last-child {
  border-bottom: none;
}
.value-content.data-v-8b95dc90 {
  display: flex;
  align-items: center;
}
.value.data-v-8b95dc90 {
  font-size: 28rpx;
  color: #666666;
}
.value.openid.data-v-8b95dc90 {
  font-size: 24rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 统计区域 */
.stats-section.data-v-8b95dc90 {
  padding: 24rpx 0;
}
.section-header.data-v-8b95dc90 {
  padding: 0 30rpx 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.header-title.data-v-8b95dc90 {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.stats-grid.data-v-8b95dc90 {
  display: flex;
  padding: 24rpx 0;
}
.stat-item.data-v-8b95dc90 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-value.data-v-8b95dc90 {
  font-size: 36rpx;
  font-weight: 600;
  color: #4CAF50;
}
.stat-label.data-v-8b95dc90 {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 操作按钮 */
.action-section.data-v-8b95dc90 {
  padding-top: 20rpx;
}
.btn.data-v-8b95dc90 {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.btn-primary.data-v-8b95dc90 {
  background-color: #4CAF50;
  color: #FFFFFF;
}
.btn-block.data-v-8b95dc90 {
  width: 100%;
}

