<view class="address-page data-v-72eb5b25"><view class="address-list data-v-72eb5b25"><block wx:for="{{addressList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="address-item card data-v-72eb5b25"><view class="address-header data-v-72eb5b25"><view data-event-opts="{{[['tap',[['selectAddress',['$0'],[[['addressList','id',item.id]]]]]]]}}" class="address-info data-v-72eb5b25" bindtap="__e"><view class="name-phone data-v-72eb5b25"><text class="name data-v-72eb5b25">{{item.name}}</text><text class="phone data-v-72eb5b25">{{item.phone}}</text></view><block wx:if="{{item.isDefault===1}}"><view class="address-tags data-v-72eb5b25"><text class="default-tag data-v-72eb5b25">默认</text></view></block></view></view><view data-event-opts="{{[['tap',[['selectAddress',['$0'],[[['addressList','id',item.id]]]]]]]}}" class="address-body data-v-72eb5b25" bindtap="__e"><text class="address-text data-v-72eb5b25">{{''+item.province+item.city+item.district+item.address+''}}</text></view><view class="address-footer data-v-72eb5b25"><view class="footer-actions data-v-72eb5b25"><block wx:if="{{item.isDefault!==1}}"><view data-event-opts="{{[['tap',[['setDefault',['$0'],[[['addressList','id',item.id]]]]]]]}}" class="action-item data-v-72eb5b25" bindtap="__e"><text class="action-text data-v-72eb5b25">设为默认</text></view></block><block wx:else><view class="action-item data-v-72eb5b25"><text class="action-text disabled data-v-72eb5b25">默认地址</text></view></block><view data-event-opts="{{[['tap',[['editAddress',['$0'],[[['addressList','id',item.id]]]]]]]}}" class="action-item data-v-72eb5b25" bindtap="__e"><text class="action-text data-v-72eb5b25">编辑</text></view><view data-event-opts="{{[['tap',[['deleteAddress',['$0'],[[['addressList','id',item.id]]]]]]]}}" class="action-item data-v-72eb5b25" bindtap="__e"><text class="action-text delete data-v-72eb5b25">删除</text></view></view></view></view></block></view><block wx:if="{{addressList.length===0}}"><view class="empty data-v-72eb