{
  "name": "恋家环保师傅端",
  "appid": "__UNI__LIANJIA",
  "description": "恋家环保师傅端小程序",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": []
      },
      "ios": {
        "deploymentTarget": "9.0"
      },
      "splashscreen": {
        "androidStyle": "default",
        "iosStyle": "default"
      }
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "mp-baidu": {
    "usingComponents": true
  },
  "mp-toutiao": {
    "usingComponents": true
  },
  "h5": {
    "devServer": {
      "port": 8080,
      "disableHostCheck": true,
      "https": false
    },
    "router": {
      "mode": "hash",
      "base": "/"
    },
    "optimization": {
      "prefetch": true,
      "preload": true
    }
  },
  "vueVersion": "2"
}
